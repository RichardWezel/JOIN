SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Used by `manage.py reset_demo` to create the admin account once. Optional.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Rate limit for login / register / guest-login per client IP (DRF format).
AUTH_THROTTLE_RATE=10/min
# Number of reverse proxies in front of gunicorn (nginx = 1). Needed so the
# limit counts the visitor's IP from X-Forwarded-For, not the proxy's.
NUM_PROXIES=1
